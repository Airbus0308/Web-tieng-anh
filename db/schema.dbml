// IELTS Master — Database Schema (DBML for DrawDB / ChartDB / dbdiagram.io)
// Compatible with Phase 9B (db/store.js) & Long-Term LMS Architecture (Phase 9–12)

Project ielts_master_lms {
  database_type: 'PostgreSQL'
  Note: 'IELTS Master LMS & SRL-SLA Adaptive Study Platform Schema'
}

// 1. Users, Learner Profiles & Device Sessions (Better-Auth style Session Guard)
Table users {
  id varchar(64) [pk, note: 'e.g. usr_... or legacy']
  kind varchar(16) [not null, default: 'guest', note: 'guest | member']
  role varchar(16) [not null, default: 'guest', note: 'guest | student | instructor | admin']
  display_name varchar(120) [default: 'Học viên IELTS']
  email varchar(255) [unique, null]
  passcode_hash varchar(255) [null, note: 'scrypt hash of IELTS-XXXX-XXXX sync passcode']
  input_band decimal(2,1) [null]
  target_band decimal(2,1) [default: 7.0]
  exam_date date [null]
  commit_time varchar(5) [default: '20:00']
  commit_minutes int [default: 25]
  current_streak int [default: 0]
  longest_streak int [default: 0]
  active_dates jsonb [note: 'Array of YYYY-MM-DD strings']
  achievements jsonb [note: 'Unlocked badges & TRF certificates']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table user_sessions {
  id varchar(64) [pk]
  user_id varchar(64) [not null, ref: > users.id]
  token_sha256 varchar(64) [not null, unique, note: 'SHA-256 of HttpOnly cookie im_uid']
  device_label varchar(200) [note: 'User-Agent summary for 3-device Session Guard']
  ip_address varchar(64)
  last_seen_at timestamp [default: `now()`]
  expires_at timestamp [not null]
  created_at timestamp [default: `now()`]
}

// 2. Courses, Textbooks & Units (Frappe LMS & LearnHouse structure)
Table courses {
  id varchar(64) [pk, note: 'e.g. cambridge-academic, vocab-collocations']
  title varchar(200) [not null]
  skill varchar(64) [not null, note: 'Reading & Writing | Vocabulary | Grammar | Speaking']
  band_range varchar(32) [not null, note: 'e.g. 5.5-7.0']
  band_min decimal(2,1) [not null]
  band_max decimal(2,1) [not null]
  focus_tags jsonb [note: 'Array of target criteria: TR, CC, LR, GRA, FC, PR, placement']
  is_published boolean [default: true]
  position int [default: 0]
}

Table course_units {
  id varchar(64) [pk, note: 'e.g. cam-u1, voc-u1, mistake_writing_...']
  course_id varchar(64) [null, ref: > courses.id]
  owner_user_id varchar(64) [null, ref: > users.id, note: 'Set for AI-generated personal or mistake units']
  title varchar(200) [not null]
  band_range varchar(32)
  level_tag varchar(32) [not null, note: 'Foundation | Intermediate | Advanced']
  target_weakness jsonb [not null, note: 'Array of Reading, Listening, TR, CC, LR, GRA, FC, PR']
  source_type varchar(32) [default: 'textbook', note: 'textbook | text | youtube | article | mistakes']
  lesson_json jsonb [not null, note: '5-step schema: lesson (with Feynman & bandUpgradeExamples), flashcards (IPA & cloze), quiz, drill, challenge']
  position int [default: 0]
  created_at timestamp [default: `now()`]
}

// 3. Enrollments & User Progress (Mastery 0% -> 100%)
Table enrollments {
  id varchar(64) [pk]
  user_id varchar(64) [not null, ref: > users.id]
  course_id varchar(64) [not null, ref: > courses.id]
  enrolled_at timestamp [default: `now()`]
  completed_at timestamp [null]
}

Table user_unit_progress {
  id varchar(64) [pk]
  user_id varchar(64) [not null, ref: > users.id]
  unit_id varchar(120) [not null, ref: > course_units.id]
  title varchar(200)
  source varchar(40) [default: 'textbook']
  mastery int [not null, default: 0, note: '0 | 20 | 40 | 60 | 80 | 100']
  completed_steps jsonb [note: 'Array of step numbers [1,2,3,4,5]']
  mini_score int [null]
  updated_at timestamp [default: `now()`]
}

// 4. Assessments: Placement, Writing, Speaking & SRL-SLA Checkpoints
Table placement_attempts {
  id varchar(64) [pk]
  user_id varchar(64) [not null, ref: > users.id]
  correct_count int [not null]
  total_count int [not null]
  estimated_band decimal(2,1) [not null]
  reading_correct int
  listening_correct int
  weak_areas jsonb
  integrity_json jsonb [note: 'ExamSecurity: tabSwitches, pasteAttempts, keystrokes, wpm, burstDetected, flagged']
  created_at timestamp [default: `now()`]
}

Table writing_attempts {
  id varchar(64) [pk]
  user_id varchar(64) [not null, ref: > users.id]
  task_type varchar(16) [default: 'task2', note: 'task1 | task2']
  topic text
  essay text [not null]
  word_count int [not null]
  overall_band decimal(2,1) [not null]
  criteria_json jsonb [not null, note: 'TR/TA, CC, LR, GRA scores & feedback']
  inline_corrections jsonb [note: 'Array of { original, correction, explanation }']
  provider varchar(80)
  integrity_json jsonb
  created_at timestamp [default: `now()`]
}

Table speaking_attempts {
  id varchar(64) [pk]
  user_id varchar(64) [not null, ref: > users.id]
  part varchar(32)
  topic text
  transcript text [not null]
  word_count int [not null]
  duration_seconds int [null]
  overall_band decimal(2,1) [not null]
  criteria_json jsonb [not null, note: 'FC, LR, GRA, PR scores & feedback']
  suggestions_json jsonb
  provider varchar(80)
  integrity_json jsonb
  created_at timestamp [default: `now()`]
}

Table study_checkpoints {
  id varchar(64) [pk]
  user_id varchar(64) [not null, ref: > users.id]
  unit_id varchar(120) [ref: > course_units.id]
  unit_title varchar(200)
  score int [not null, note: '0-100, passed if >= 70']
  passed boolean [not null]
  input_band decimal(2,1)
  self_predicted_band decimal(2,1)
  output_band decimal(2,1)
  band_delta decimal(2,1)
  calibration_gap decimal(2,1) [note: 'output_band - self_predicted_band (COPES metacognition)']
  self_difficulty_reason varchar(255)
  criteria_breakdown jsonb [note: 'taskAchievement, lexicalResource, grammarAccuracy']
  used_target_words jsonb
  missed_target_words jsonb
  inline_corrections jsonb
  created_at timestamp [default: `now()`]
}

// 5. Spaced Repetition Queue (SRS 0-1-3-7-14 days)
Table srs_items {
  item_id varchar(64) [pk]
  user_id varchar(64) [not null, ref: > users.id]
  unit_id varchar(120)
  word varchar(255) [not null]
  meaning text
  example text
  source varchar(80) [note: 'flashcard | checkpoint | checkpoint-correction | mistake-unit']
  interval_days int [not null, default: 0]
  repetitions int [not null, default: 0]
  next_review_at timestamp [not null]
  last_reviewed_at timestamp [null]
}

// 6. Orders, Coupons & Certificates (Phase 12 Commercial & TRF Extension)
Table orders {
  id varchar(64) [pk]
  user_id varchar(64) [not null, ref: > users.id]
  course_id varchar(64) [ref: > courses.id]
  amount_vnd int [not null, default: 0]
  coupon_code varchar(32) [null]
  payment_provider varchar(32) [note: 'free | vietqr | payos | sepay | stripe']
  status varchar(24) [not null, default: 'paid', note: 'pending | paid | refunded']
  created_at timestamp [default: `now()`]
}

Table certificates {
  id varchar(64) [pk, note: 'TRF verification code']
  user_id varchar(64) [not null, ref: > users.id]
  course_id varchar(64) [null, ref: > courses.id]
  overall_band decimal(2,1) [not null]
  cefr_level varchar(8) [not null, note: 'B1 | B2 | C1 | C2']
  skills_snapshot jsonb [not null, note: 'Reading, Listening, Writing, Speaking bands']
  integrity_verified boolean [default: true]
  issued_at timestamp [default: `now()`]
}
